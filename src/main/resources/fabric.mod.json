{
  "schemaVersion": 1,
  "id": "wildbosses",
  "version": "${version}",
  "name": "WildBosses",
  "description": "Adds rare, roaming Boss Pokémon to Cobblemon with dynamic scaling, smarter battles, tiered loot, Enrage, Mega Evolution support, cooldowns, and progression.",
  "authors": [
    "kaizzinho"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/wildbosses",
    "sources": "https://github.com/kaizzinho/WildBosses",
    "issues": "https://github.com/kaizzinho/WildBosses/issues"
  },
  "license": "MIT",
  "icon": "assets/wildbosses/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "com.kaizzinho.wildbosses.WildBosses"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "com.kaizzinho.wildbosses.WildBossesClient"
      }
    ],
    "modmenu": [
      {
        "adapter": "kotlin",
        "value": "com.kaizzinho.wildbosses.config.WildBossesModMenuIntegration"
      }
    ]
  },
  "depends": {
    "minecraft": "1.21.1",
    "fabricloader": ">=0.17.2",
    "fabric-language-kotlin": ">=1.13.6+kotlin.2.2.20",
    "cobblemon": ">=1.8.0"
  },
  "mixins": [
    "wildbosses.mixins.json"
  ],
  "suggests": {
    "modmenu": ">=11.0.3",
    "cobbletunes": "*",
    "cobblemonbattleintroduction": "*",
    "simplehats": "*"
  },
  "custom": {
    "modmenu": {
      "update_checker": true
    }
  }
}
